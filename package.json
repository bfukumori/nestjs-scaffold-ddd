{
	"name": "nestjs-scaffold",
	"version": "0.0.1",
	"description": "Template base de um projeto em NestJS 12 (ESM)",
	"author": "Bruno Fukumori <brunofukumori@gmail.com>",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "nest build",
		"deploy": "nest deploy",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "bunx biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "vitest --inspect-brk --no-file-parallelism",
		"test:e2e": "vitest run --config ./vitest.config.e2e.ts"
	},
	"dependencies": {
		"@fastify/compress": "^9.2.2",
		"@fastify/static": "^10.1.6",
		"@nestjs/authentication": "^0.1.1",
		"@nestjs/common": "^12.1.3",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.1.3",
		"@nestjs/mail": "^0.0.1",
		"@nestjs/platform-fastify": "^12.1.3",
		"@nestjs/swagger": "^12.0.2",
		"@nestjs/throttler": "^6.7.1",
		"nestjs-pino": "^5.3.1",
		"pino-pretty": "^13.2.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@nestjs/cli": "^12.0.8",
		"@nestjs/schematics": "^12.0.7",
		"@nestjs/testing": "^12.1.3",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.16.18",
		"@types/node": "^26.6.5",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.0.5",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.1",
		"typescript": "^6.0.3",
		"unplugin-swc": "^2.0.0",
		"vitest": "^5.0.5"
	}
}
